generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  leadgenId String   @unique
  name      String?
  email     String?
  phone     String?
  adName    String?
  adId      String?
  formId    String?
  pageId    String?
  pageName  String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  formName  String?
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
